# Anthropic: required
ANTHROPIC_API_KEY=sk-ant-...

# Tavily: required for web search (chapters 2-12)
# Create a free account at tavily.com
TAVILY_API_KEY=tvly-...

# LangSmith: optional, for observability (chapter 6)
# Create a free account at smith.langchain.com
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=market-agent

# Groq: optional, for model fallback (chapter 10)
# Create a free account at console.groq.com
GROQ_API_KEY=gsk_...

# REST API: authentication key for the chapter 11 API
API_KEY=change-this-to-a-secure-key

# SMTP: optional, for sending monitoring emails (chapter 12)
# If not configured, the system prints the report to the console instead of sending it
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
